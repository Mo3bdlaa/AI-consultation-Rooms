# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model id from https://openrouter.ai/models
# Free models (good for testing the 1000 req/day tier) end with ":free"
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: shown to OpenRouter for analytics, safe to leave as-is
APP_TITLE=AI Consultation Rooms
